# Copy this file to .env and fill in your own keys.
# Never commit .env.

# Required for audio transcription through Volcengine Ark / Doubao Seed 2.0.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL_ID_LITE=doubao-seed-2-0-lite-260428
ARK_MODEL_ID_MINI=doubao-seed-2-0-mini-260428

# Required for text correction, summaries, report polishing, and model switching.
# DeepSeek official endpoint is OpenAI-compatible.
TEXT_API_KEY=
TEXT_BASE_URL=https://api.deepseek.com
TEXT_MODEL_ID=deepseek-v4-pro
TEXT_THINKING=enabled
TEXT_REASONING_EFFORT=max

# Optional: use another OpenAI-compatible text model instead of DeepSeek.
# Examples:
# TEXT_BASE_URL=https://api.deepseek.com
# TEXT_MODEL_ID=deepseek-v4-flash
# TEXT_BASE_URL=https://api.moonshot.cn/v1
# TEXT_MODEL_ID=kimi-k2
# TEXT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# TEXT_MODEL_ID=glm-4.5

# Optional Qwen Omni fallback. Leave empty unless you want this path.
DASHSCOPE_API_KEY=
QWEN_MODEL_ID=qwen3.5-omni-flash

# Runtime tuning.
MEDIA_SEGMENT_SECONDS=60
MEDIA_MAX_WORKERS=5
MEDIA_FFMPEG_SPLIT_TIMEOUT=1800

